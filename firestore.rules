rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation helper for UserProfile
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid']) &&
        data.uid is string && data.uid == request.auth.uid &&
        (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 256)) &&
        (!('displayName' in data) || data.displayName == null || (data.displayName is string && data.displayName.size() <= 128)) &&
        (!('photoURL' in data) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 1024)) &&
        (!('telegramBotToken' in data) || data.telegramBotToken == null || (data.telegramBotToken is string && data.telegramBotToken.size() <= 256)) &&
        (!('telegramChatId' in data) || data.telegramChatId == null || (data.telegramChatId is string && data.telegramChatId.size() <= 64)) &&
        (!('telegramBotUsername' in data) || data.telegramBotUsername == null || (data.telegramBotUsername is string && data.telegramBotUsername.size() <= 64)) &&
        (!('defaultExchange' in data) || (data.defaultExchange in ['all', 'binance', 'bybit'])) &&
        (!('defaultMarketType' in data) || (data.defaultMarketType in ['all', 'futures', 'spot'])) &&
        (!('defaultTimeframe' in data) || (data.defaultTimeframe in ['5m', '15m', '1h', '4h', '1d'])) &&
        (!('soundAlertsEnabled' in data) || data.soundAlertsEnabled is bool) &&
        (!('watchlist' in data) || data.watchlist is list) &&
        (!('metaScalpSettings' in data) || data.metaScalpSettings is map) &&
        (!('inviteCode' in data) || data.inviteCode == null || (data.inviteCode is string && data.inviteCode.size() <= 64)) &&
        (!('createdAt' in data) || data.createdAt == null || (data.createdAt is string && data.createdAt.size() <= 64)) &&
        (!('updatedAt' in data) || data.updatedAt == null || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // Validation helper for PriceAlert
    function isValidPriceAlert(data) {
      return data.keys().hasAll(['id', 'userId', 'symbol', 'exchange', 'marketType', 'targetPrice', 'condition', 'isActive', 'triggered']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId == request.auth.uid &&
        data.symbol is string && data.symbol.size() <= 32 &&
        (data.exchange in ['binance', 'bybit']) &&
        (data.marketType in ['futures', 'spot']) &&
        (data.targetPrice is int || data.targetPrice is float) && data.targetPrice > 0 &&
        (data.condition in ['gte', 'lte']) &&
        data.isActive is bool &&
        data.triggered is bool &&
        (!('note' in data) || data.note == null || (data.note is string && data.note.size() <= 500)) &&
        (!('formationName' in data) || data.formationName == null || (data.formationName is string && data.formationName.size() <= 128)) &&
        (!('levelType' in data) || (data.levelType in ['entry', 'target', 'stop_loss', 'custom']));
    }

    // Validation helper for AlertHistory
    function isValidAlertHistory(data) {
      return data.keys().hasAll(['id', 'userId', 'symbol', 'exchange', 'marketType', 'condition', 'targetPrice', 'triggeredPrice', 'telegramSent', 'triggeredAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId == request.auth.uid &&
        data.symbol is string && data.symbol.size() <= 32 &&
        (data.exchange in ['binance', 'bybit']) &&
        (data.marketType in ['futures', 'spot']) &&
        (data.condition in ['gte', 'lte']) &&
        (data.targetPrice is int || data.targetPrice is float) &&
        (data.triggeredPrice is int || data.triggeredPrice is float) &&
        data.telegramSent is bool &&
        (data.triggeredAt is int || data.triggeredAt is float) &&
        (!('alertId' in data) || data.alertId == null || (data.alertId is string && data.alertId.size() <= 128)) &&
        (!('note' in data) || data.note == null || (data.note is string && data.note.size() <= 500)) &&
        (!('formationName' in data) || data.formationName == null || (data.formationName is string && data.formationName.size() <= 128)) &&
        (!('levelType' in data) || (data.levelType in ['entry', 'target', 'stop_loss', 'custom'])) &&
        (!('telegramError' in data) || data.telegramError == null || (data.telegramError is string && data.telegramError.size() <= 500)) &&
        (!('createdAt' in data) || data.createdAt == null || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    // Validation helper for ArchivedFormation
    function isValidArchivedFormation(data) {
      return data.keys().hasAll(['id', 'userId', 'symbol', 'exchange', 'marketType', 'timeframe', 'formationName', 'bias', 'entryPrice', 'targetPrice', 'stopLossPrice']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId == request.auth.uid &&
        data.symbol is string && data.symbol.size() <= 32 &&
        (data.exchange in ['binance', 'bybit']) &&
        (data.marketType in ['futures', 'spot']) &&
        (data.timeframe in ['5m', '15m', '1h', '4h', '1d']) &&
        data.formationName is string && data.formationName.size() <= 128 &&
        (data.bias in ['bullish', 'bearish', 'neutral']) &&
        (data.entryPrice is int || data.entryPrice is float) &&
        (data.targetPrice is int || data.targetPrice is float) &&
        (data.stopLossPrice is int || data.stopLossPrice is float) &&
        (!('baseAsset' in data) || data.baseAsset == null || (data.baseAsset is string && data.baseAsset.size() <= 16)) &&
        (!('quoteAsset' in data) || data.quoteAsset == null || (data.quoteAsset is string && data.quoteAsset.size() <= 16)) &&
        (!('savedPrice' in data) || (data.savedPrice is int || data.savedPrice is float)) &&
        (!('necklinePrice' in data) || (data.necklinePrice is int || data.necklinePrice is float)) &&
        (!('supportPrice' in data) || (data.supportPrice is int || data.supportPrice is float)) &&
        (!('resistancePrice' in data) || (data.resistancePrice is int || data.resistancePrice is float)) &&
        (!('confidence' in data) || (data.confidence is int || data.confidence is float)) &&
        (!('status' in data) || data.status == null || (data.status is string && data.status.size() <= 32)) &&
        (!('savedAtTimestamp' in data) || (data.savedAtTimestamp is int || data.savedAtTimestamp is float)) &&
        (!('markers' in data) || data.markers is list) &&
        (!('chartParams' in data) || data.chartParams is map) &&
        (!('formation' in data) || data.formation is map) &&
        (!('notes' in data) || data.notes == null || (data.notes is string && data.notes.size() <= 1000)) &&
        (!('createdAt' in data) || data.createdAt == null || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    // User Profile collection - strict privacy: only the authenticated user can access their own document
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidUserProfile(incoming()) && incoming().uid == existing().uid;
      allow delete: if isOwner(userId);

      // User-specific price alerts collection
      match /alerts/{alertId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(alertId) && isValidPriceAlert(incoming());
        allow update: if isOwner(userId) && isValidPriceAlert(incoming()) && incoming().userId == existing().userId && incoming().id == existing().id;
        allow delete: if isOwner(userId);
      }

      // User-specific alert history collection
      match /history/{historyId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(historyId) && isValidAlertHistory(incoming());
        allow update: if false; // History is immutable
        allow delete: if isOwner(userId);
      }

      // User-specific saved formations archive collection
      match /archive/{archiveId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(archiveId) && isValidArchivedFormation(incoming());
        allow update: if isOwner(userId) && isValidArchivedFormation(incoming()) && incoming().userId == existing().userId && incoming().id == existing().id;
        allow delete: if isOwner(userId);
      }
    }
  }
}
